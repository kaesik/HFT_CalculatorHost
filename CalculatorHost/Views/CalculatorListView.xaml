<UserControl x:Class="CalculatorHost.Views.CalculatorListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CalculatorHost.Views">

    <UserControl.Resources>
        <Style x:Key="CalculatorSegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="10,7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentColorBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalculatorSortChipStyle"
               TargetType="RadioButton"
               BasedOn="{StaticResource CalculatorSegmentStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
        </Style>

        <Style x:Key="CalculatorFavoriteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FavoriteBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FavoriteBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCalculatorListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CalculatorCard"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CalculatorCard"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CalculatorCard"
                                        Property="Background"
                                        Value="{DynamicResource CardBgBrush}" />
                                <Setter TargetName="CalculatorCard"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="320" MaxWidth="480" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: List -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,20,20,14">
                    <TextBlock Text="Kalkulatory"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Modern search, filters and quick sorting -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DividerColorBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0,16,14">
                    <StackPanel>
                        <Border Height="42"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SearchTextBox"
                                             Padding="0,10,0,8"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             FontSize="12"
                                             ToolTip="Szukaj kalkulatora po nazwie"
                                             TextChanged="SearchTextBox_TextChanged" />

                                    <TextBlock x:Name="SearchPlaceholderText"
                                               Text="Szukaj kalkulatora..."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>

                                <Button x:Name="ClearSearchButton"
                                        Grid.Column="2"
                                        Style="{StaticResource CalculatorFavoriteButtonStyle}"
                                        Width="28"
                                        Height="28"
                                        Content="&#xE711;"
                                        FontSize="11"
                                        ToolTip="Wyczyść wyszukiwanie"
                                        Visibility="Collapsed"
                                        Click="ClearSearchButton_Click" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource ControlBgBrush}"
                                CornerRadius="9"
                                Padding="3"
                                Margin="0,0,0,12">
                            <UniformGrid Rows="1" Columns="3">
                                <RadioButton x:Name="AllCalculatorsFilterButton"
                                             GroupName="CalculatorFilters"
                                             Style="{StaticResource CalculatorSegmentStyle}"
                                             Tag="Wszystkie"
                                             Content="Wszystkie"
                                             Checked="CalculatorFilterButton_Checked" />
                                <RadioButton x:Name="FavoriteCalculatorsFilterButton"
                                             GroupName="CalculatorFilters"
                                             Style="{StaticResource CalculatorSegmentStyle}"
                                             Tag="Ulubione"
                                             Content="★  Ulubione"
                                             Checked="CalculatorFilterButton_Checked" />
                                <RadioButton x:Name="RecentCalculatorsFilterButton"
                                             GroupName="CalculatorFilters"
                                             Style="{StaticResource CalculatorSegmentStyle}"
                                             Tag="Ostatnie"
                                             Content="Ostatnie"
                                             Checked="CalculatorFilterButton_Checked" />
                            </UniformGrid>
                        </Border>

                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Sortuj"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />

                            <UniformGrid Grid.Column="2" Rows="1" Columns="3">
                                <RadioButton x:Name="NameSortButton"
                                             GroupName="CalculatorSort"
                                             Style="{StaticResource CalculatorSortChipStyle}"
                                             Tag="Nazwa A-Z"
                                             Content="A–Z  Nazwa"
                                             Margin="0,0,4,0"
                                             Checked="CalculatorSortButton_Checked" />
                                <RadioButton x:Name="ModifiedSortButton"
                                             GroupName="CalculatorSort"
                                             Style="{StaticResource CalculatorSortChipStyle}"
                                             Tag="Ostatnio zmienione"
                                             Content="Edycja"
                                             Margin="0,0,4,0"
                                             Checked="CalculatorSortButton_Checked" />
                                <RadioButton x:Name="LastUsedSortButton"
                                             GroupName="CalculatorSort"
                                             Style="{StaticResource CalculatorSortChipStyle}"
                                             Tag="Ostatnio używane"
                                             Content="Używane"
                                             Checked="CalculatorSortButton_Checked" />
                            </UniformGrid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Folder Missing Warning -->
                <Border Grid.Row="2"
                        Visibility="{Binding IsFolderMissing, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="16,8">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBgBrush}"
                                CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Folder nie istnieje"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Folder z kalkulatorami jest niedostępny. Sprawdź konfigurację folderu." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Calculator List -->
                <ListBox x:Name="CalculatorList"
                         Grid.Row="2"
                         ItemContainerStyle="{StaticResource ModernCalculatorListItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="CalculatorList_SelectionChanged"
                         MouseDoubleClick="CalculatorList_MouseDoubleClick"
                         KeyDown="CalculatorList_KeyDown"
                         Visibility="{Binding IsFolderMissing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Margin="6,13,6,5"
                                            Padding="2,0,2,3">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:CalculatorListEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,10,0"
                                        Background="{DynamicResource ControlBgBrush}"
                                        CornerRadius="9">
                                    <TextBlock Text="&#xE8EF;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Bottom" />

                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ModifiedText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                                </TextBlock>

                                <Button Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        Style="{StaticResource CalculatorFavoriteButtonStyle}"
                                        Margin="8,0,0,0"
                                        Content="{Binding FavoriteIcon}"
                                        ToolTip="{Binding FavoriteToolTip}"
                                        Focusable="False"
                                        Click="FavoriteButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource DividerColorBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <Grid>
                        <TextBlock x:Name="CountText"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="UpdateAllCachesButton"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE895;"
                                    ToolTip="Aktualizuj pamięć wszystkich kalkulatorów"
                                    Click="UpdateAllCachesButton_Click"
                                    Margin="0,0,4,0" />

                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE72C;"
                                    ToolTip="Odśwież listę kalkulatorów"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Panel: Details + Versions -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="EmptySelectionPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="&#xE8A5;"
                           FontFamily="Segoe MDL2 Assets" FontSize="72"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Opacity="0.35" />
                <TextBlock Text="Wybierz kalkulator"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,6" Opacity="0.5" />
                <TextBlock Text="Po kliknięciu zobaczysz szczegóły i zapisane wersje"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Opacity="0.5" />
            </StackPanel>

            <Grid x:Name="CalculatorDetailsPanel"
                  Visibility="Collapsed"
                  Margin="32"
                  MaxWidth="760"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="WYBRANY KALKULATOR"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="SelectedCalculatorNameText"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource DividerColorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ostatnia edycja"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="SelectedCalculatorModifiedText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="Rozmiar pliku"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="SelectedCalculatorSizeText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBgBrush}"
                        BorderBrush="{DynamicResource DividerColorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="WERSJA DO OTWARCIA"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,4" />

                            <Button x:Name="VersionPanelOptionsButton"
                                    Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    ToolTip="Opcje wersji"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="VersionPanelOptionsButton_Click">
                                <TextBlock Text="&#xE712;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Pokaż folder z wersjami"
                                                  Click="ShowVersionsFolderMenuItem_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8DA;"
                                                           FontFamily="Segoe MDL2 Assets" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <ListBox x:Name="VersionList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="VersionList_SelectionChanged"
                                 MouseDoubleClick="VersionList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:VersionListEntry}">
                                    <Border Padding="10,8"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,1,10,0" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DisplayNameVisibility}">
                                                <Run Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <Run Text="  " />
                                                <Run Text="{Binding SizeText}"
                                                     FontSize="10"
                                                     Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </TextBlock>

                                            <Grid Grid.Row="0" Grid.Column="1"
                                                  Margin="0,-2,0,0"
                                                  Visibility="{Binding RenameEditorVisibility}"
                                                  PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox x:Name="InlineRenameTextBox"
                                                         Grid.Column="0"
                                                         Text="{Binding EditedName, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="180"
                                                         Padding="6,3"
                                                         Tag="{Binding}"
                                                         KeyDown="InlineRenameTextBox_KeyDown"
                                                         Loaded="InlineRenameTextBox_Loaded"
                                                         PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Margin="6,0,0,0"
                                                        Tag="{Binding}"
                                                        ToolTip="Zapisz nazwę"
                                                        Click="ConfirmInlineRenameButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                    <TextBlock Text="&#xE73E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Margin="4,0,0,0"
                                                        Tag="{Binding}"
                                                        ToolTip="Anuluj zmianę nazwy"
                                                        Click="CancelInlineRenameButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                    <TextBlock Text="&#xE711;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding Details}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DisplayNameVisibility}" />

                                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,0,0"
                                                        Visibility="{Binding ActionButtonsVisibility}">
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        ToolTip="{Binding FavoriteToolTip}"
                                                        Visibility="{Binding SavedVersionButtonVisibility}"
                                                        Click="FavoriteVersionButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                    <TextBlock Text="{Binding FavoriteIcon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        ToolTip="{Binding DefaultToolTip}"
                                                        Visibility="{Binding CurrentFileDefaultButtonVisibility}"
                                                        Click="DefaultVersionButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown"
                                                        Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding DefaultIcon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        ToolTip="Więcej akcji"
                                                        Visibility="{Binding MoreActionsButtonVisibility}"
                                                        Click="VersionMoreActionsButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown"
                                                        Margin="4,0,0,0">
                                                    <TextBlock Text="&#xE712;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Zmień nazwę"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="RenameVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8AC;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Kopiuj"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="CopyVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8C8;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Ustaw jako domyślną"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.DefaultButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="DefaultVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE718;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator
                                                                Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                            <MenuItem Header="Usuń"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="DeleteVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE74D;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="VersionStatusText"
                                   Grid.Row="2"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button x:Name="UploadVersionButton"
                            Content="Wgraj wersję"
                            MinWidth="160"
                            Padding="14,8"
                            Click="UploadVersionButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Error Notification -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="{DynamicResource ErrorBrush}"
                    CornerRadius="6" Margin="20" Padding="14,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12" Foreground="White"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bulk cache update status -->
        <Border x:Name="CacheUpdatePanel"
                Grid.ColumnSpan="2"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Width="620"
                MaxWidth="760"
                Margin="24"
                Padding="18"
                Panel.ZIndex="100"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="3"
                                  Opacity="0.25" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="CacheUpdateTitleText"
                                   Text="Aktualizacja pamięci kalkulatorów"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="CacheUpdateCalculatorText"
                                   Text=""
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button x:Name="CloseCacheUpdatePanelButton"
                            Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Content="&#xE711;"
                            ToolTip="Zamknij"
                            Click="CloseCacheUpdatePanelButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Postęp całkowity"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock x:Name="CacheUpdateOverallPercentText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <ProgressBar x:Name="CacheUpdateOverallProgressBar"
                             Grid.Row="2"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,5,0,0" />

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="CacheUpdateStageText"
                                   Text="Aktualny etap"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="CacheUpdateDetailText"
                                   Text=""
                                   Margin="0,2,12,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="CacheUpdateStagePercentText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Top" />
                </Grid>

                <ProgressBar x:Name="CacheUpdateStageProgressBar"
                             Grid.Row="4"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,6,0,0" />

                <Grid Grid.Row="5" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CacheUpdateStatsText"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />

                    <Button x:Name="CancelCacheUpdateButton"
                            Grid.Column="1"
                            Content="Anuluj"
                            MinWidth="90"
                            Padding="12,6"
                            IsEnabled="False"
                            Click="CancelCacheUpdateButton_Click" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>