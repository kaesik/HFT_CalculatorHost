<UserControl x:Class="CalculatorHost.Views.CalculatorListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CalculatorHost.Views">

    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="240" MaxWidth="480" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: List -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,20,20,12">
                    <TextBlock Text="DOSTĘPNE KALKULATORY"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,6" />
                </StackPanel>

                <!-- Folder Missing Warning -->
                <Border Grid.Row="1"
                        Visibility="{Binding IsFolderMissing, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="16,8">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBgBrush}"
                                CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Folder nie istnieje"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Folder z kalkulatorami jest niedostępny. Sprawdź konfigurację folderu." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Calculator List -->
                <ListBox x:Name="CalculatorList"
                         Grid.Row="1"
                         ItemContainerStyle="{StaticResource CalculatorListItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="CalculatorList_SelectionChanged"
                         MouseDoubleClick="CalculatorList_MouseDoubleClick"
                         KeyDown="CalculatorList_KeyDown"
                         Visibility="{Binding IsFolderMissing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:CalculatorListEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding SizeText}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ModifiedText}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource DividerColorBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <Grid>
                        <TextBlock x:Name="CountText"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right"
                                Content="&#xE72C;"
                                ToolTip="Odśwież listę kalkulatorów"
                                Command="{Binding RefreshCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Panel: Details + Versions -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="EmptySelectionPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="&#xE8A5;"
                           FontFamily="Segoe MDL2 Assets" FontSize="72"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Opacity="0.35" />
                <TextBlock Text="Wybierz kalkulator"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,6" Opacity="0.5" />
                <TextBlock Text="Po kliknięciu zobaczysz szczegóły i zapisane wersje"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Opacity="0.5" />
            </StackPanel>

            <Grid x:Name="CalculatorDetailsPanel"
                  Visibility="Collapsed"
                  Margin="32"
                  MaxWidth="760"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="WYBRANY KALKULATOR"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="SelectedCalculatorNameText"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource DividerColorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ostatnia edycja"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="SelectedCalculatorModifiedText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="Rozmiar pliku"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="SelectedCalculatorSizeText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBgBrush}"
                        BorderBrush="{DynamicResource DividerColorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="WERSJA DO OTWARCIA"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,0,0,4" />
                        </StackPanel>

                        <ListBox x:Name="VersionList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="VersionList_SelectionChanged"
                                 MouseDoubleClick="VersionList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:VersionListEntry}">
                                    <Border Padding="10,8"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,1,10,0" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DisplayNameVisibility}">
                                                <Run Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <Run Text="  " />
                                                <Run Text="{Binding SizeText}"
                                                     FontSize="10"
                                                     Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </TextBlock>

                                            <Grid Grid.Row="0" Grid.Column="1"
                                                  Margin="0,-2,0,0"
                                                  Visibility="{Binding RenameEditorVisibility}"
                                                  PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox x:Name="InlineRenameTextBox"
                                                         Grid.Column="0"
                                                         Text="{Binding EditedName, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="180"
                                                         Padding="6,3"
                                                         Tag="{Binding}"
                                                         KeyDown="InlineRenameTextBox_KeyDown"
                                                         Loaded="InlineRenameTextBox_Loaded"
                                                         PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Margin="6,0,0,0"
                                                        Tag="{Binding}"
                                                        ToolTip="Zapisz nazwę"
                                                        Click="ConfirmInlineRenameButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                    <TextBlock Text="&#xE73E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Margin="4,0,0,0"
                                                        Tag="{Binding}"
                                                        ToolTip="Anuluj zmianę nazwy"
                                                        Click="CancelInlineRenameButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                    <TextBlock Text="&#xE711;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding Details}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DisplayNameVisibility}" />

                                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,0,0"
                                                        Visibility="{Binding ActionButtonsVisibility}">
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        ToolTip="{Binding FavoriteToolTip}"
                                                        Visibility="{Binding SavedVersionButtonVisibility}"
                                                        Click="FavoriteVersionButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown">
                                                    <TextBlock Text="{Binding FavoriteIcon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        ToolTip="{Binding DefaultToolTip}"
                                                        Visibility="{Binding CurrentFileDefaultButtonVisibility}"
                                                        Click="DefaultVersionButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown"
                                                        Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding DefaultIcon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Tag="{Binding}"
                                                        ToolTip="Więcej akcji"
                                                        Visibility="{Binding MoreActionsButtonVisibility}"
                                                        Click="VersionMoreActionsButton_Click"
                                                        PreviewMouseLeftButtonDown="VersionActionButton_PreviewMouseLeftButtonDown"
                                                        Margin="4,0,0,0">
                                                    <TextBlock Text="&#xE712;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Zmień nazwę"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="RenameVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8AC;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Kopiuj"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="CopyVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8C8;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Ustaw jako domyślną"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.DefaultButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="DefaultVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE718;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator
                                                                Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                            <MenuItem Header="Usuń"
                                                                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Visibility="{Binding PlacementTarget.Tag.SavedVersionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                      Click="DeleteVersionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE74D;"
                                                                               FontFamily="Segoe MDL2 Assets" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="VersionStatusText"
                                   Grid.Row="2"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button x:Name="UploadVersionButton"
                            Content="Wgraj wersję"
                            MinWidth="160"
                            Padding="14,8"
                            Click="UploadVersionButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Error Notification -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="{DynamicResource ErrorBrush}"
                    CornerRadius="6" Margin="20" Padding="14,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12" Foreground="White"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>