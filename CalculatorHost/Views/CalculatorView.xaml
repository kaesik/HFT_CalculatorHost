<UserControl x:Class="CalculatorHost.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition x:Name="MacroRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource BackButton}"
                        ToolTip="Wróć do listy kalkulatorów (zamknij kalkulator)"
                        Click="BackButton_Click"
                        Margin="0,8,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Lista"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Left"
                        Width="1"
                        Background="{DynamicResource DividerColorBrush}"
                        Margin="0,9,10,9" />

                <Button DockPanel.Dock="Right"
                        Content="Przelicz"
                        ToolTip="Zapisz wprowadzone wartości i przelicz arkusz"
                        Command="{Binding CalculateCommand}"
                        Style="{StaticResource MacroButton}"
                        Margin="8,10,2,10"
                        Padding="18,5" />

                <Button DockPanel.Dock="Right"
                        Content="Wczytaj wersję"
                        ToolTip="Wczytaj zapisane wartości inputów i dropdownów z pliku JSON"
                        Style="{StaticResource MacroButton}"
                        Margin="4,10,0,10"
                        Padding="12,5"
                        Click="LoadVersionButton_Click" />

                <Button DockPanel.Dock="Right"
                        Content="Zapisz wersję"
                        ToolTip="Zapisz aktualne inputy i dropdowny do pliku JSON"
                        Style="{StaticResource MacroButton}"
                        Margin="4,10,0,10"
                        Padding="12,5"
                        Click="SaveVersionButton_Click" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,4,0">
                    <TextBlock Text="Zoom"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button Content="−"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Style="{StaticResource MacroButton}"
                            ToolTip="Pomniejsz widok arkusza"
                            Click="ZoomOut_Click" />
                    <Slider x:Name="ZoomSlider"
                            Width="104"
                            Minimum="75"
                            Maximum="150"
                            Value="100"
                            TickFrequency="25"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="8,0"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <Button Content="+"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Style="{StaticResource MacroButton}"
                            ToolTip="Powiększ widok arkusza"
                            Click="ZoomIn_Click" />
                    <Button x:Name="ZoomValueButton"
                            Content="100%"
                            MinWidth="48"
                            Height="24"
                            Padding="6,0"
                            Style="{StaticResource MacroButton}"
                            ToolTip="Przywróć zoom 100%"
                            Margin="8,0,0,0"
                            Click="ResetZoom_Click" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,8,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="{Binding CalculatorName}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <TextBlock x:Name="SheetNameText"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Arkusz: -" />
                        <TextBlock Text="  ·  "
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock x:Name="SheetCounterText"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="Komórki: -" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="MacroButtonsBorder"
                Grid.Row="1"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="MAKRA"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <WrapPanel x:Name="MacroButtonsPanel" Orientation="Horizontal" />
            </DockPanel>
        </Border>

        <Border x:Name="CellPreviewBorder"
                Grid.Row="2"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="KOMÓRKA"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <Border Background="{DynamicResource ControlBgBrush}"
                            BorderBrush="{DynamicResource DividerColorBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinWidth="54"
                            Padding="8,4">
                        <TextBlock x:Name="SelectedCellAddressText"
                                   Text=""
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBox x:Name="SelectedCellContentBox"
                         Text="Kliknij komórkę, aby zobaczyć jej pełną treść."
                         IsReadOnly="True"
                         Background="White"
                         BorderBrush="#C9D2E1"
                         BorderThickness="1"
                         FontFamily="Segoe UI Variable, Segoe UI"
                         FontSize="13"
                         Foreground="#111827"
                         CaretBrush="#111827"
                         SelectionBrush="#BFDBFE"
                         Padding="10,5"
                         MinHeight="36"
                         MaxHeight="88"
                         VerticalContentAlignment="Center"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource ControlBgBrush}">
            <Grid>
                <ScrollViewer x:Name="SheetScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource ControlBgBrush}"
                              Focusable="False"
                              Padding="22">
                    <Grid x:Name="SheetViewport"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True"
                          RenderOptions.EdgeMode="Aliased"
                          RenderOptions.BitmapScalingMode="HighQuality">
                        <Border x:Name="SheetCard"
                                Background="White"
                                BorderBrush="#D7DEE9"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22"
                                                  ShadowDepth="4"
                                                  Opacity="0.18"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter x:Name="SheetContentPresenter"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Border Background="{DynamicResource LoadingOverlayBrush}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        Panel.ZIndex="100">
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource DividerColorBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="30,26"
                            Width="540"
                            MaxWidth="540"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="5"
                                              Opacity="0.28"
                                              Color="#000000" />
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="&#xE9F5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="34"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{Binding LoadingTitle}"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,12,0,3" />

                            <TextBlock Text="{Binding LoadingDetail}"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="460"
                                       MinHeight="18"
                                       Margin="0,0,0,22" />

                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,7">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding OverallProgressText}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="12,0,0,0" />
                                <TextBlock Text="Postęp całkowity"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding OverallProgress, Mode=OneWay}"
                                         Height="10"
                                         Foreground="{DynamicResource AccentColorBrush}"
                                         Background="{DynamicResource ControlBgBrush}" />

                            <DockPanel LastChildFill="True"
                                       Margin="0,22,0,7">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding StageProgressText}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="12,0,0,0" />
                                <TextBlock Text="{Binding LoadingStage}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding StageProgress, Mode=OneWay}"
                                         Height="10"
                                         Foreground="{DynamicResource AccentColorBrush}"
                                         Background="{DynamicResource ControlBgBrush}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border Background="{DynamicResource LoadingOverlayBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="8"
                            Padding="32,28"
                            MaxWidth="480"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="4"
                                              Opacity="0.3"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="42"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Wystąpił błąd"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,8" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="380" />
                            <Button Content="Wróć"
                                    Style="{StaticResource MacroButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0"
                                    Click="ErrorBackButton_Click" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left"
                           x:Name="SheetInfoText"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right"
                           Text="Zmień wartości i kliknij Przelicz, aby zaktualizować wyniki"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>