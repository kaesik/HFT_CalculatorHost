<UserControl x:Class="CalculatorHost.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition x:Name="MacroRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource BackButton}"
                        ToolTip="Wróć do listy kalkulatorów (zamknij kalkulator)"
                        Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Lista"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Left"
                        Width="1"
                        Background="{DynamicResource DividerColorBrush}"
                        Margin="6,6" />

                <Button DockPanel.Dock="Right"
                        Content="Przelicz"
                        ToolTip="Zapisz wprowadzone wartości i przelicz arkusz"
                        Command="{Binding CalculateCommand}"
                        Style="{StaticResource MacroButton}"
                        Margin="8,4,4,4"
                        Padding="16,5" />

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding CalculatorName}"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0" />
            </DockPanel>
        </Border>

        <Border x:Name="MacroButtonsBorder"
                Grid.Row="1"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="MAKRA"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <WrapPanel x:Name="MacroButtonsPanel" Orientation="Horizontal" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource ControlBgBrush}">
            <Grid>
                <ScrollViewer x:Name="SheetScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="White"
                              Focusable="False" />

                <Border Background="{DynamicResource LoadingOverlayBrush}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Opacity="0.9">
                        <TextBlock Text="&#xE9F5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="36"
                                   Foreground="{DynamicResource AccentColorBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="Proszę czekać…"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource LoadingOverlayBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="8"
                            Padding="32,28"
                            MaxWidth="480"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="4"
                                              Opacity="0.3"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="42"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Wystąpił błąd"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,8" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="380" />
                            <Button Content="Zamknij kalkulator"
                                    Style="{StaticResource MacroButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0"
                                    Click="BackButton_Click" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource DividerColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left"
                           x:Name="SheetInfoText"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right"
                           Text="Zmień wartości i kliknij Przelicz, aby zaktualizować wyniki"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>