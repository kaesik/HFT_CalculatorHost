<Window x:Class="CalculatorHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator Host"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="1380" Height="860"
        MinWidth="900" MinHeight="560"
        Background="Transparent"
        AllowsTransparency="False"
        Icon="/Assets/CalculatorHostIcon.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource WindowBorderBrushBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBgBrush}"
                    BorderBrush="{DynamicResource DividerColorBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="CALCULATOR HOST"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleCalculatorName"
                                   Text=""
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE921;"
                                ToolTip="Minimalizuj"
                                Click="Minimize_Click" />
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE793;"
                                ToolTip="Przełącz motyw (ciemny / jasny)"
                                Click="ThemeToggle_Click" />
                        <Button Style="{StaticResource CloseButton}"
                                Content="&#xE8BB;"
                                ToolTip="Zamknij"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ContentControl x:Name="MainContent" Grid.Row="1" />
        </Grid>
    </Border>
</Window>